# ── Application ──
NEXT_PUBLIC_APP_NAME=AtomCV

# Where this deployment is served from. Used for canonical URLs, the
# hreflang map, robots.txt and sitemap.xml — all of which need an absolute
# origin and cannot guess one. **Set it at deploy time.** The fallback is
# localhost rather than a domain: a sitemap listing a hostname nobody has
# registered points at somebody else's site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Backend API ──
# Same-origin path. In production nginx routes /api/* to Spring.
# In development next.config.ts rewrites it to API_PROXY_TARGET.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Rewrite target for local development. Server-side only — never exposed.
API_PROXY_TARGET=http://localhost:8080

# ── Turnstile ──
# Site key for the sign-in form's challenge. Public by design; the secret is
# the backend's. Leave empty locally: with no secret configured the server has
# the challenge switched off, and the widget then draws nothing (B-050).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Mocking ──
# "enabled" loads MSW handlers instead of calling the backend.
# Set to anything else (or remove) to talk to a real backend.
NEXT_PUBLIC_API_MOCKING=enabled

# ── Observability (filled in at Stage 3) ──
NEXT_PUBLIC_SENTRY_DSN=
