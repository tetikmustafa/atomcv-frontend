#!/usr/bin/env bash
# Mirror of atomcv-backend/.githooks/post-commit — same mechanism, opposite
# direction. Syncs docs/handoff/**.md and docs/STATUS.md to the sibling
# backend repo. Never touches docs/spec/** (frontend doesn't own spec; that
# stays a manual/Claude-run sync via scripts/sync-spec.sh, run from backend).
#
# Setup (once per machine):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/post-commit
#   # only if your backend checkout is NOT at ../atomcv-backend:
#   git config atomcv.siblingPath /absolute/path/to/atomcv-backend
set -euo pipefail

LAST_MSG=$(git log -1 --pretty=%s 2>/dev/null || echo "")
[[ "$LAST_MSG" == chore\(docs-sync\):* ]] && exit 0

CHANGED=$(git diff --name-only HEAD~1 HEAD -- docs/handoff/ docs/STATUS.md 2>/dev/null || true)
[ -z "$CHANGED" ] && exit 0

SIBLING="$(git config --get atomcv.siblingPath || echo "../atomcv-backend")"

if [ ! -d "$SIBLING/.git" ]; then
  echo "[docs-sync] Sibling repo not found at: $SIBLING"
  echo "[docs-sync] Set the correct path with:"
  echo "  git config atomcv.siblingPath /absolute/path/to/atomcv-backend"
  exit 0
fi

mkdir -p "$SIBLING/docs/handoff"
cp docs/handoff/*.md "$SIBLING/docs/handoff/" 2>/dev/null || true
cp docs/STATUS.md "$SIBLING/docs/" 2>/dev/null || true

(
  cd "$SIBLING"
  git add docs/handoff docs/STATUS.md 2>/dev/null || true
  if ! git diff --cached --quiet 2>/dev/null; then
    git commit -q -m "chore(docs-sync): receive handoff + STATUS from frontend"
    echo "[docs-sync] handoff + STATUS synced and committed in $SIBLING"
  fi
)
